# ---------------------------------------------------------------------------
# CSMJU Tools Shortcut Hub - example environment
# Copy to .env and adjust. NEVER commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

PORT=4206

# This subsystem owns its OWN database. It must NOT point at the Core Hub DB.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/csmju_campus_shuttle_management

# Most connections the pool opens (default 5). On the server every subsystem
# shares one PostgreSQL, so keep it small (standards docs/deployment.md 4.1).
DATABASE_POOL_MAX=5

# Core Hub (identity provider) - the real server serves its API (under /api/v1)
# and its web app from one origin (standards docs/connect-core-hub.md)
CORE_HUB_URL=https://csmju2030.jowave.com

# Core Hub public key set (public material only - never the private key)
CORE_HUB_JWKS_URL=https://csmju2030.jowave.com/api/v1/.well-known/jwks.json

# Core Hub's web app: GET /auth/login sends the browser to <this>/sso/authorize
# and POST /auth/logout to <this>/logout
CORE_HUB_WEB_URL=https://csmju2030.jowave.com

# Immutable Core Hub JWT contract
CORE_HUB_ISSUER=core-hub
CORE_HUB_AUDIENCE=csmju2030

# JWKS cache behaviour (milliseconds)
JWKS_CACHE_TTL_MS=600000
JWKS_MIN_REFRESH_INTERVAL_MS=30000
JWKS_REQUEST_TIMEOUT_MS=5000

# Subsystem identity - the name in Core Hub's Subsystem Registry. It also
# prefixes the cookies: csmju_campus_shuttle_management_access_token / _sso_state
SUBSYSTEM_ID=csmju-campus-shuttle-management
SUBSYSTEM_NAME=CSMJU UniRide

# Clock skew tolerance when validating exp/iat (seconds)
JWT_CLOCK_TOLERANCE_SEC=5
