// Tools Shortcut Hub - Database Schema
//
// Naming follows the CSMJU2030 Subsystem Standard: PostgreSQL tables are plural
// snake_case and every column is snake_case through @map, while Prisma/TypeScript
// field names stay camelCase. Application code is therefore unchanged.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum BusServiceStatus {
  RUNNING
  BREAK
  OFF_DUTY
}

enum RideRequestStatus {
  WAITING
  PICKED_UP
  CANCELLED
}

enum LostItemType {
  LOST
  FOUND
}

enum LostItemStatus {
  OPEN
  RETURNED
  CLOSED
}

enum ProblemCategory {
  LATE
  DRIVER
  VEHICLE
  SAFETY
  OTHER
}

enum ProblemStatus {
  OPEN
  RESOLVED
}

enum PassengerLevel {
  LOW
  MEDIUM
  HIGH
  FULL
}

/// เส้นทางรถรับส่ง
model ShuttleRoute {
  id             String   @id @default(uuid())
  name           String
  description    String?
  departureTimes String[] @default([]) @map("departure_times")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  stops         ShuttleStop[]
  locations     BusLocation[]
  rideRequests  RideRequest[]
  lostItems     LostItem[]
  reviews       ServiceReview[]
  announcements Announcement[]
  problems      ProblemReport[]

  @@map("shuttle_routes")
}

/// จุดจอดในแต่ละเส้นทาง (เรียงตาม sequence)
model ShuttleStop {
  id        String   @id @default(uuid())
  routeId   String   @map("route_id")
  name      String
  latitude  Float
  longitude Float
  sequence  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  route        ShuttleRoute  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  locations    BusLocation[]
  rideRequests RideRequest[]

  @@unique([routeId, sequence])
  @@map("shuttle_stops")
}

/// ตำแหน่งรถที่เจ้าหน้าที่/คนขับรายงาน (ใช้ polling ดูตำแหน่งล่าสุด)
model BusLocation {
  id                   String         @id @default(uuid())
  routeId              String         @map("route_id")
  currentStopId        String?        @map("current_stop_id")
  latitude             Float
  longitude            Float
  passengerLevel       PassengerLevel @default(LOW) @map("passenger_level")
  passengerCount       Int?           @map("passenger_count")
  serviceStatus        BusServiceStatus @default(RUNNING) @map("service_status")
  reportedByCoreUserId String         @map("reported_by_core_user_id")
  reportedAt           DateTime       @default(now()) @map("reported_at")

  route       ShuttleRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  currentStop ShuttleStop? @relation(fields: [currentStopId], references: [id], onDelete: SetNull)

  @@index([routeId, reportedAt])
  @@map("bus_locations")
}

/// นักศึกษาเรียกรถ: "ฉันรออยู่ที่ป้ายนี้"
model RideRequest {
  id                    String            @id @default(uuid())
  routeId               String            @map("route_id")
  stopId                String            @map("stop_id")
  requestedByCoreUserId String            @map("requested_by_core_user_id")
  status                RideRequestStatus @default(WAITING)
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  route ShuttleRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop  ShuttleStop  @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@index([stopId, status])
  @@map("ride_requests")
}

/// แจ้งของหาย (นักศึกษา) / ของที่พบบนรถ (คนขับ)
model LostItem {
  id                   String         @id @default(uuid())
  routeId              String?        @map("route_id")
  type                 LostItemType
  description          String
  status               LostItemStatus @default(OPEN)
  reportedByCoreUserId String         @map("reported_by_core_user_id")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  route ShuttleRoute? @relation(fields: [routeId], references: [id], onDelete: SetNull)

  @@map("lost_items")
}

/// รีวิวการบริการคนขับ/สายรถ
model ServiceReview {
  id                   String   @id @default(uuid())
  routeId              String?  @map("route_id")
  rating               Int
  comment              String?
  reviewedByCoreUserId String   @map("reviewed_by_core_user_id")
  createdAt            DateTime @default(now()) @map("created_at")

  route ShuttleRoute? @relation(fields: [routeId], references: [id], onDelete: SetNull)

  @@map("service_reviews")
}

/// ประกาศ/แจ้งเตือนถึงนักศึกษา (คนขับหรือผู้ดูแล)
model Announcement {
  id                  String   @id @default(uuid())
  routeId             String?  @map("route_id")
  message             String
  createdByCoreUserId String   @map("created_by_core_user_id")
  createdAt           DateTime @default(now()) @map("created_at")

  route ShuttleRoute? @relation(fields: [routeId], references: [id], onDelete: SetNull)

  @@map("announcements")
}

/// แจ้งปัญหา (รถมาช้า คนขับ ตัวรถ ความปลอดภัย อื่น ๆ) ถึงผู้ดูแล
model ProblemReport {
  id                   String          @id @default(uuid())
  routeId              String?         @map("route_id")
  category             ProblemCategory
  message              String
  status               ProblemStatus   @default(OPEN)
  reportedByCoreUserId String          @map("reported_by_core_user_id")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  route ShuttleRoute? @relation(fields: [routeId], references: [id], onDelete: SetNull)

  @@map("problem_reports")
}
